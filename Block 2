    # Spearman
    log_step('Computing Spearman correlations...')
    rho_nat, pval_nat = stats.spearmanr(_df['flood_frac'], _df['frac_high_hazard'])
    stat_results['spearman_national'] = {
        'rho': round(float(rho_nat),4), 'pval': float(pval_nat), 'n': int(len(_df))}
    rho_by_region = {}
    for region, ufs in MACRO_REGIONS.items():
        sub = _df[_df['SIGLA_UF'].isin(ufs)]
        if len(sub) < 10: continue
        r, p = stats.spearmanr(sub['flood_frac'], sub['frac_high_hazard'])
        rho_by_region[region] = {'rho':round(float(r),4),'pval':float(p),'n':int(len(sub))}
    stat_results['spearman_by_region'] = rho_by_region
    log_step(f'Spearman: rho={rho_nat:.3f}  p={pval_nat:.2e}  n={len(_df):,}', 'ok')

    # Spatial Lag Model + Moran's I
    log_step('Spatial statistics...')
    try:
        geo    = (muni_stats[muni_stats['CD_MUN'].isin(_df['CD_MUN'])]
                  .copy().dropna(subset=['geometry']).to_crs('EPSG:6933')
                  .drop_duplicates('CD_MUN').sort_values('CD_MUN'))
        df_slm = (_df.drop_duplicates('CD_MUN').sort_values('CD_MUN')
                     [_df['CD_MUN'].isin(geo['CD_MUN'])].reset_index(drop=True))
        geo    = geo[geo['CD_MUN'].isin(df_slm['CD_MUN'])].reset_index(drop=True)
        assert list(df_slm['CD_MUN']) == list(geo['CD_MUN'])
        W = KNN.from_dataframe(geo, k=5); W.transform = 'R'
        y = df_slm['EDHI'].values.reshape(-1,1)
        hcol = 'hand_p50_m' if 'hand_p50_m' in df_slm.columns else 'hand_p50'
        X = df_slm[['flood_frac', hcol]].fillna(0).values
        slm = ML_Lag(y, X, W, name_y='EDHI',
                     name_x=['flood_frac', hcol], name_ds='Brazil municipalities')
        stat_results['spatial_lag_model'] = {
            'rho_spatial': round(float(slm.rho),4),
            'rho_pval'   : float(slm.z_stat[-1][1]),
            'pseudo_r2'  : round(float(slm.pr2),4),
            'AIC'        : round(float(slm.aic),2),
            'n'          : int(slm.n)}
        log_step(f'SLM: rho={slm.rho:.3f}  pseudo-R2={slm.pr2:.3f}', 'ok')
        mi = Moran(df_slm['EDHI'].values, W)
        stat_results['morans_I'] = {
            'I':round(float(mi.I),4),'pval':float(mi.p_sim),'z':round(float(mi.z_sim),3)}
        log_step(f"Moran's I: {mi.I:.4f}  p={mi.p_sim:.4f}", 'ok')
    except Exception as e:
        log_step(f'Spatial stats failed: {e}', 'warn')
        stat_results['spatial_lag_model'] = {'error': str(e)}
        stat_results['morans_I']           = {'error': str(e)}

    # 2x2 matrix
    mat   = _df['matrix_cell'].value_counts()
    tp,fp,fn,tn = (int(mat.get('TP',0)), int(mat.get('FP',0)),
                   int(mat.get('FN',0)), int(mat.get('TN',0)))
    total = tp+fp+fn+tn
    fpr   = fp/max(fp+tn,1); fnr = fn/max(fn+tp,1)
    mcc   = (tp*tn-fp*fn)/max(math.sqrt((tp+fp)*(tp+fn)*(tn+fp)*(tn+fn)),1)
    stat_results['classification_matrix'] = {
        'TP':tp,'FP':fp,'FN':fn,'TN':tn,'total':total,
        'false_positive_rate':round(fpr,4),'false_negative_rate':round(fnr,4),
        'MCC':round(mcc,4)}
    log_step(f'2x2: FPR={fpr*100:.1f}%  FNR={fnr*100:.1f}%  MCC={mcc:.3f}', 'ok')

    ckpt_save_json(stat_results, STAT_CKPT)
