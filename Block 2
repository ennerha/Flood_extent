def normalize_cdmun(series):
    return series.astype(str).str.extract(r'(\d+)', expand=False).str.zfill(7)

def ckpt_valid(name: str, required_cols: list, min_nonzero_col: str = None) -> bool:
    """
    Returns True only if the checkpoint parquet:
      1. Exists
      2. Contains all required_cols
      3. If min_nonzero_col given: that column has at least 10% non-zero/non-null values
    Deletes the checkpoint if invalid so next run recomputes it.
    """
    if not ckpt_exists(name):
        return False
    try:
        df = pd.read_parquet(ckpt_path(name))
        missing = [c for c in required_cols if c not in df.columns]
        if missing:
            log_step(f'Checkpoint {name} missing columns {missing} — invalidating', 'warn')
            ckpt_path(name).unlink()
            return False
        if min_nonzero_col and min_nonzero_col in df.columns:
            col = df[min_nonzero_col]
            valid_frac = col.notna().mean() if col.dtype == object else (col != 0).mean()
            if valid_frac < 0.05:
                log_step(f'Checkpoint {name}: {min_nonzero_col} is {valid_frac*100:.1f}% valid '
                         f'(expected >5%) — invalidating stale checkpoint', 'warn')
                ckpt_path(name).unlink()
                # Also invalidate downstream checkpoints
                for downstream in ['muni_stats_BR', 'statistical_results']:
                    if ckpt_exists(downstream):
                        ckpt_path(downstream).unlink()
                        log_step(f'  Also invalidated downstream: {downstream}.parquet', 'warn')
                    _j = OUT_CKPT / f'{downstream}.json'
                    if _j.exists():
                        _j.unlink()
                        log_step(f'  Also invalidated downstream: {downstream}.json', 'warn')
                return False
        return True
    except Exception as e:
        log_step(f'Checkpoint {name} unreadable ({e}) — invalidating', 'warn')
        ckpt_path(name).unlink()
        return False

