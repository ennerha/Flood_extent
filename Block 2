def _find_csvs(pattern):
    found = []
    for d in [OUT, OUT_DATA, DRIVE_ROOT / DRIVE_FOLDER]:
        if d.exists():
            found += list(d.glob(pattern))
    return list({f.name: f for f in found}.values())

if ckpt_valid(STATS_CKPT,
              required_cols=['CD_MUN','flood_area_km2','frac_high_hazard'],
              min_nonzero_col='frac_high_hazard'):
    log_step('Municipal stats: loading checkpoint...')
    stats_df = ckpt_load(STATS_CKPT)

else:
    # Detect which UFs already have BOTH CSVs
    _done_ufs = set()
    for uf in ALL_UFS:
        if (_find_csvs(f'muni_stats_IBGE_{uf}_{SCALE_M}m.csv') and
                _find_csvs(f'muni_hand_IBGE_{uf}_{SCALE_M}m.csv')):
            _done_ufs.add(uf)
    log_step(f'UFs with existing CSVs: {sorted(_done_ufs)}', 'ok')

    tasks = {}
    for uf in ALL_UFS:
        if uf in _done_ufs:
            log_step(f'{uf}: CSVs exist, skipping', 'ok')
            continue

        uf_gdf   = muni_gdf.loc[muni_gdf['SIGLA_UF'] == uf,
                                 ['CD_MUN','NM_MUN','SIGLA_UF','geometry']].copy()
        uf_simpl = uf_gdf.to_crs('EPSG:6933')
        uf_simpl['geometry'] = uf_simpl.geometry.simplify(250, preserve_topology=True)
        uf_simpl = uf_simpl.to_crs('EPSG:4326')
        fc = gdf_to_ee_fc(uf_simpl)

        # Task 1: flood metrics only — no HAND join
        desc_flood = f'muni_stats_IBGE_{uf}_{SCALE_M}m'
        fc_flood_only = img_flood.reduceRegions(
            collection=fc, reducer=reducer_flood,
            scale=SCALE_M, tileScale=TILE_SCALE)
        t_flood = ee.batch.Export.table.toDrive(
            collection=fc_flood_only,
            description=desc_flood, folder=DRIVE_FOLDER,
            fileNamePrefix=desc_flood, fileFormat='CSV')
        t_flood.start()

        # Task 2: HAND class histogram over ALL municipal pixels (no flood mask)
        desc_hand = f'muni_hand_IBGE_{uf}_{SCALE_M}m'
        fc_hand_only = img_hand_all.reduceRegions(
            collection=fc, reducer=reducer_hand_hist,
            scale=SCALE_M, tileScale=TILE_SCALE)
        t_hand = ee.batch.Export.table.toDrive(
            collection=fc_hand_only,
            description=desc_hand, folder=DRIVE_FOLDER,
            fileNamePrefix=desc_hand, fileFormat='CSV')
        t_hand.start()

        tasks[uf] = (t_flood, t_hand)
        log_step(f'{uf}: tasks started [{t_flood.id}] [{t_hand.id}]', 'ok')

    if tasks:
        log_step(f'Monitoring {len(tasks)*2} GEE tasks ({len(tasks)} UFs)...')
        pbar = tqdm_nb(total=len(ALL_UFS), initial=len(_done_ufs),
                       desc='UF exports', unit='UF')
        done_set = set(_done_ufs)
        while len(done_set) < len(ALL_UFS):
            for uf, (t1, t2) in list(tasks.items()):
                if uf in done_set: continue
                s1 = t1.status().get('state','UNKNOWN')
                s2 = t2.status().get('state','UNKNOWN')
                if s1 == 'COMPLETED' and s2 == 'COMPLETED':
                    done_set.add(uf)
                    pbar.update(1)
                    pbar.set_postfix({'last': uf})
                    log_step(f'{uf}: both tasks completed', 'ok')
                elif s1 in ('FAILED','CANCELLED'):
                    raise RuntimeError(f'{uf} flood: {t1.status().get("error_message","?")}')
                elif s2 in ('FAILED','CANCELLED'):
                    raise RuntimeError(f'{uf} hand: {t2.status().get("error_message","?")}')
            time.sleep(30)
        pbar.close()
        log_step('All UF tasks completed', 'ok')

    # Wait for Drive sync
    log_step('Waiting for Drive CSV sync...')
    t0 = time.time()
    while True:
        _fc = _find_csvs(f'muni_stats_IBGE_*_{SCALE_M}m.csv')
        _hc = _find_csvs(f'muni_hand_IBGE_*_{SCALE_M}m.csv')
        if len(_fc) >= len(ALL_UFS) and len(_hc) >= len(ALL_UFS):
            break
        elapsed = time.time() - t0
        if elapsed > 600:
            log_step(f'flood={len(_fc)} hand={len(_hc)}/{len(ALL_UFS)} after '
                     f'{elapsed/60:.0f} min. Continuing.', 'warn')
            break
        log_step(f'  Syncing... flood={len(_fc)} hand={len(_hc)}/{len(ALL_UFS)}',
                 'info')
        time.sleep(15)

    flood_csvs = _find_csvs(f'muni_stats_IBGE_*_{SCALE_M}m.csv')
    hand_csvs  = _find_csvs(f'muni_hand_IBGE_*_{SCALE_M}m.csv')
    if not flood_csvs:
        raise FileNotFoundError('No flood CSVs. Check Drive + GEE tasks.')
    if not hand_csvs:
        raise FileNotFoundError('No HAND CSVs. Check Drive + GEE tasks.')
    log_step(f'Found {len(flood_csvs)} flood + {len(hand_csvs)} HAND CSVs', 'ok')

    # Parse flood CSVs
    flood_frames = []
    for csv in sorted(flood_csvs):
        df = pd.read_csv(csv)
        if df.empty or 'CD_MUN' not in df.columns: continue
        df['CD_MUN'] = normalize_cdmun(df['CD_MUN'])
        ren = {}
        for c in df.columns:
            cl = c.lower()
            if 'p25' in cl and 'hand' in cl: ren[c] = 'hand_p25_m'
            if 'p50' in cl and 'hand' in cl: ren[c] = 'hand_p50_m'
            if 'p75' in cl and 'hand' in cl: ren[c] = 'hand_p75_m'
            if 'p90' in cl and 'hand' in cl: ren[c] = 'hand_p90_m'
            if 'p95' in cl and 'hand' in cl: ren[c] = 'hand_p95_m'
            if 'freq_mean' in cl:            ren[c] = 'flood_freq_mean'
        df = df.rename(columns=ren).drop(
            columns=['.geo','system:index'], errors='ignore')
        flood_frames.append(df)
    flood_df = pd.concat(flood_frames, ignore_index=True)
    flood_df['CD_MUN'] = normalize_cdmun(flood_df['CD_MUN'])

    # Parse HAND histogram CSVs
    hand_frames = []
    for csv in sorted(hand_csvs):
        df = pd.read_csv(csv)
        if df.empty or 'CD_MUN' not in df.columns: continue
        df['CD_MUN'] = normalize_cdmun(df['CD_MUN'])
        # GEE names the frequencyHistogram output 'histogram'
        hist_col = next((c for c in df.columns
                         if c.lower() == 'histogram' or c.lower() == 'hand_class_histogram'), None)
        if hist_col is None:
            # fallback: any column with 'hist'
            hist_col = next((c for c in df.columns if 'hist' in c.lower()), None)
        if hist_col is None:
            log_step('No histogram column in ' + str(csv.name) + '. Cols: ' + str(df.columns.tolist()), 'warn')
            continue

        def _ph(v):
            """Parse GEE histogram string.
            Handles both JSON format  {"1":123}
            and Python dict format    {1=123, 2=456}
            """
            s = str(v).strip()
            try:
                # Standard JSON: {"1": 123}
                h = json.loads(s.replace("'", '"'))
            except Exception:
                try:
                    s2 = s.strip('{}')
                    h = {}
                    for part in s2.split(','):
                        part = part.strip()
                        if '=' in part:
                            k, val = part.split('=', 1)
                            h[k.strip()] = float(val.strip())
                except Exception:
                    h = {}
            return (int(h.get('1', h.get(1, 0))),
                    int(h.get('2', h.get(2, 0))),
                    int(h.get('3', h.get(3, 0))),
                    int(h.get('4', h.get(4, 0))))

        hp = df[hist_col].apply(_ph)
        df[['hand_1_px','hand_2_px','hand_3_px','hand_4_px']] = (
            pd.DataFrame(hp.tolist(), index=df.index))
        df['hand_total_px']    = df[['hand_1_px','hand_2_px',
                                      'hand_3_px','hand_4_px']].sum(axis=1)
        df['hand_dom_class']   = (df[['hand_1_px','hand_2_px',
                                       'hand_3_px','hand_4_px']]
                                  .idxmax(axis=1).str.extract(r'(\d)').squeeze())
        df['frac_high_hazard'] = (
            (df['hand_1_px'] + df['hand_2_px']) /
            df['hand_total_px'].clip(lower=1)).round(4)
        hand_frames.append(df[['CD_MUN','hand_1_px','hand_2_px','hand_3_px',
                                'hand_4_px','hand_total_px','hand_dom_class',
                                'frac_high_hazard']].copy())

    hand_df = pd.concat(hand_frames, ignore_index=True)
    hand_df['CD_MUN'] = normalize_cdmun(hand_df['CD_MUN'])
    hand_df = hand_df.drop_duplicates('CD_MUN')

    # Join flood + HAND on CD_MUN
    stats_df = flood_df.merge(hand_df, on='CD_MUN', how='left')
    if 'hand_p95_m' in stats_df.columns:
        stats_df['vol_proxy_km2m'] = (
            stats_df['flood_area_km2'] *
            stats_df['hand_p95_m'].fillna(0)).round(4)
    else:
        stats_df['vol_proxy_km2m'] = 0.0

    log_step(f'Rows before dedup: {len(stats_df):,}')
    stats_df = stats_df.dropna(subset=['CD_MUN']).copy()
    stats_df['CD_MUN'] = normalize_cdmun(stats_df['CD_MUN'])
    if stats_df['CD_MUN'].duplicated().any():
        sc = 'flood_area_km2' if 'flood_area_km2' in stats_df.columns else 'CD_MUN'
        stats_df = (stats_df.sort_values(sc, ascending=False)
                            .drop_duplicates('CD_MUN', keep='first')
