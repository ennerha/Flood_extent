    area['muni_area_km2'] = area.geometry.area / 1e6
    area = area[['CD_MUN','muni_area_km2']].drop_duplicates('CD_MUN')
    agg  = agg.merge(area, on='CD_MUN', how='left', validate='1:1')

    if 'flood_area_km2' in agg.columns and 'flood_area_km2_sum' not in agg.columns:
        agg = agg.rename(columns={'flood_area_km2': 'flood_area_km2_sum'})

    agg['flood_area_km2_sum'] = agg['flood_area_km2_sum'].fillna(0)
    agg['flood_frac']         = (agg['flood_area_km2_sum'] /
                                  agg['muni_area_km2'].clip(lower=0.01)).clip(upper=1).round(4)
    agg['frac_high_hazard']   = ((agg['hand_1_px'] + agg['hand_2_px']) /
                                   agg['hand_total_px'].clip(lower=1)).round(4)
    agg['hand_dom_class']     = (agg[['hand_1_px','hand_2_px','hand_3_px','hand_4_px']]
                                  .idxmax(axis=1).str.extract(r'(\d)').squeeze())
    agg['EDHI'] = (agg['flood_frac'] - agg['frac_high_hazard']).round(4)

    flooded  = agg[agg['flood_area_km2_sum'] > 0].copy()
    ext_med  = flooded['flood_frac'].median()
    haz_med  = flooded['frac_high_hazard'].median()
    flooded['ext_class']   = np.where(flooded['flood_frac'] >= ext_med, 'H','L')
    flooded['haz_class']   = np.where(flooded['frac_high_hazard'] >= haz_med,'H','L')
    flooded['matrix_cell'] = np.select([
        (flooded['ext_class']=='H') & (flooded['haz_class']=='H'),
        (flooded['ext_class']=='H') & (flooded['haz_class']=='L'),
        (flooded['ext_class']=='L') & (flooded['haz_class']=='H'),
        (flooded['ext_class']=='L') & (flooded['haz_class']=='L')],
        ['TP','FP','FN','TN'], default='NA')
    agg = agg.merge(flooded[['CD_MUN','ext_class','haz_class','matrix_cell']],
