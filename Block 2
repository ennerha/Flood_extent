def gdf_to_ee_fc(gdf, keep_cols=('CD_MUN','NM_MUN','SIGLA_UF')):
    features = []
    gdf = gdf.to_crs('EPSG:4326').copy()
    for _, row in gdf.iterrows():
        geom = row.geometry
        if geom is None or geom.is_empty: continue
        props = {c: str(row[c]) for c in keep_cols if c in row.index}
        gj   = json.loads(gpd.GeoSeries([geom], crs='EPSG:4326').to_json())
        features.append(ee.Feature(
            ee.Geometry(gj['features'][0]['geometry']), props))
    return ee.FeatureCollection(features)

