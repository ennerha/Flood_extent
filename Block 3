def code(s):
    return s.astype('string').str.strip().str.replace(r'\.0$', '',regex=True).str.zfill(7)
def numeric(df, names):
    for c in names: df[c]=pd.to_numeric(df[c], errors='coerce')
def tag(ax,letter,title):
    ax.set_title(f'{letter}   {title}',loc='left',fontsize=10,fontweight='bold',pad=9)
def cosmetic(ax,grid='y'):
    ax.grid(axis=grid,color='#dadde1',linewidth=.45,alpha=.62,zorder=0)
    ax.spines[['top','right']].set_visible(False)
    ax.tick_params(length=3,width=.6)
def export(fig,stem):
    for extension in ('png','pdf'):
        fig.savefig(OUT/f'{stem}.{extension}',dpi=450,bbox_inches='tight',facecolor='white')
    plt.show();plt.close(fig)
    print('SAVED',stem+'.png / .pdf')

